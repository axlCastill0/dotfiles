{
  "$schema": "https://raw.githubusercontent.com/fastfetch-cli/fastfetch/2.66.0/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/triforce.txt",
    "padding": {
      "top": 1,
      "right": 4,
      "left": 4,
    },
    "color": {
      "1": "#FFD700",
    },
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#C8102E",
      "title": "#C8102E",
    },
  },
  "modules": [
    "break",
    "break",
    "title",
    "break",
    {
      "type": "datetime",
      "key": "date   ",
      "format": "{1}-{3}-{11}",
    },
    {
      "type": "os",
      "key": "os     ",
    },
    {
      "type": "kernel",
      "key": "kernel ",
    },
    {
      "type": "packages",
      "key": "pkgs   ",
    },
    {
      "type": "uptime",
      "format": "{?days}{days}d {?}{hours}h {minutes}m",
      "key": "uptime ",
    },
    "break",
    { "type": "media", "key": "media  " },
  ],
}
